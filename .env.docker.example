# Copy this file to .env.docker and replace placeholder values.

ASPNETCORE_ENVIRONMENT=Development

WM_MYSQL_ROOT_PASSWORD=root
WM_MYSQL_DATABASE=webmessenger
WM_MYSQL_USER=webmessenger
WM_MYSQL_PASSWORD=webmessenger

# Optional dump import on first DB initialization.
# Put dump file into ./docker/mysql/dumps and set its container path here.
# Example:
# WM_DB_DUMP_FILE=/docker-entrypoint-initdb.d/dumps/webmessenger-dump-20260502.sql
WM_DB_DUMP_FILE=/docker-entrypoint-initdb.d/dumps/optional-dump.sql

# Use a long random secret in real environments.
JWT_KEY=replace_with_64_plus_characters
JWT_ISSUER=WebMessenger
JWT_AUDIENCE=WebMessengerClients

# Browser-facing API URL (used by client-side code)
PUBLIC_API_URL=http://localhost:5227
# Internal API URL used by Next.js server routes in container network
API_BASE_URL=http://api:8080

# Optional Dropbox settings
DROPBOX_ACCESS_TOKEN=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
